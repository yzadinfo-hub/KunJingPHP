<?php
/**
 * KunJingPHP (堃景) — 命令行入口
 *
 * 用法（在项目根目录执行）：
 *   php <框架目录>/kunjing <command> [参数] [--选项]
 *   KUNJING_BASE=/path/to/project php kunjing migrate
 *
 * 常用命令：
 *   route:list / route:cache / route:clear
 *   make:controller|model|middleware|request|migration|seeder
 *   migrate / migrate:rollback / migrate:status / db:seed
 */

if (php_sapi_name() !== 'cli') {
    exit('本脚本只能在命令行执行。' . PHP_EOL);
}

require_once __DIR__ . '/bootstrap.php';

use KunJing\Framework\Console\Kernel;

$base = getenv('KUNJING_BASE');
$base = (is_string($base) && $base !== '') ? $base : (getcwd() ?: __DIR__);

exit((new Kernel($base))->handle($argv));
